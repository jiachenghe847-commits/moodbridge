generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MoodEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  date      DateTime
  emotion   String
  intensity Int
  note      String   @default("")
}
